# ─────────────────────────────────────────────
# Panksero WhatsApp Agent — Variables de entorno
# ─────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env con credenciales reales al repositorio.

# ── WhatsApp Cloud API (Meta for Developers) ──
WHATSAPP_TOKEN=           # Token de acceso permanente (System User token)
WHATSAPP_PHONE_NUMBER_ID= # ID del número de teléfono en Meta Business
WHATSAPP_BUSINESS_ACCOUNT_ID= # ID de la cuenta de WhatsApp Business
VERIFY_TOKEN=panksero_webhook_2024  # Token de verificación del webhook (cámbialo)

# ── Anthropic (Claude API) ──
ANTHROPIC_API_KEY=        # sk-ant-...

# ── Google Apps Script (POS / Ventas) ──
GAS_URL=https://script.google.com/macros/s/AKfycbxh1fNsBrJ1M8yOtVsKGj-btxc6ENzqOyd-I381POcPSlx3Y-Fax2YU2YSN-XyjmSVP/exec

# ── Servidor ──
PORT=3000
NODE_ENV=production
