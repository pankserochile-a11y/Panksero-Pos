# ════════════════════════════════════════════════════════
#  Panksero WhatsApp Agent — Credenciales
#  Completa los valores SIN dejar espacios ni comillas
# ════════════════════════════════════════════════════════

# ── 1. WhatsApp Cloud API (Meta for Developers) ──────────
# Obtén estos valores en: https://developers.facebook.com
#   → Tu app → WhatsApp → Configuración de la API

# Token de acceso permanente (System User Token)
WHATSAPP_TOKEN=

# ID del número de teléfono (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token secreto que tú inventas para verificar el webhook
VERIFY_TOKEN=panksero_webhook_2024

# ── 2. Claude / Anthropic ─────────────────────────────────
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── 3. Google Apps Script (POS) ──────────────────────────
# URL del script que ya tienes en producción
GAS_URL=https://script.google.com/macros/s/AKfycbxh1fNsBrJ1M8yOtVsKGj-btxc6ENzqOyd-I381POcPSlx3Y-Fax2YU2YSN-XyjmSVP/exec

# ── 4. Servidor ───────────────────────────────────────────
PORT=3000
NODE_ENV=production
